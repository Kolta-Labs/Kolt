# Auto-detect text files and normalize line endings to LF across all platforms
# This prevents Windows CRLF checkouts from corrupting code generation or string templates.
* text=auto eol=lf

*.toml text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
